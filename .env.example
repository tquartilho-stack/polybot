# ── .env template — copiar para .env e preencher ────────────────────────────
# cp .env.example .env

ANTHROPIC_API_KEY=sk-ant-...

# Polymarket CLOB — obtém em https://clob.polymarket.com/
POLY_API_KEY=
POLY_API_SECRET=
POLY_PRIVATE_KEY=0x...         # private key da tua wallet Polygon
POLY_PROXY_ADDRESS=0x...       # endereço do proxy contract (Polymarket UI cria-o)

# DRY_RUN=true   → não executa trades reais (default)
# DRY_RUN=false  → execução real
DRY_RUN=true
